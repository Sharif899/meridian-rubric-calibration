# Meridian rubric calibration — environment configuration.
# Copy to .env and fill in only if you want the HTTP LLM grader.
# The default pilot run uses the deterministic MockLLMGrader and needs nothing here.

# HTTP LLM grader endpoint (OpenAI-compatible chat completions).
# MERIDIAN_LLM_ENDPOINT must be the FULL request URL, including
# /chat/completions — no path is appended; the endpoint is POSTed to
# verbatim. Example for Google Gemini (free tier, no card):
# https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
MERIDIAN_LLM_ENDPOINT=
# API key for the HTTP LLM grader. Never commit a real key.
MERIDIAN_LLM_API_KEY=
# Model name sent to the HTTP LLM grader. For the Gemini endpoint above,
# use a Flash model, e.g. gemini-2.5-flash. Default: gpt-4o-mini.
MERIDIAN_LLM_MODEL=
